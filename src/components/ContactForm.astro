---
import { SITE } from '../config/site';
---
<div class="form-panel">
  <h3 style="font-family:'Sora',sans-serif;font-weight:700;font-size:1.1rem;margin-bottom:6px">Request a Free Consultation</h3>
  <p style="font-size:.82rem;color:var(--muted);margin-bottom:16px">All fields marked <span style="color:var(--red)">*</span> are required.</p>
  <div id="cf-success" style="display:none;background:rgba(28,90,50,.08);border:1px solid rgba(28,90,50,.22);color:var(--success-text);padding:13px 16px;border-radius:var(--r-sm);font-size:.85rem;font-weight:500;margin-bottom:14px">
    ✓ Thank you! We'll be in touch within one business day.
  </div>
  <div id="cf-error" style="display:none;background:rgba(184,28,28,.07);border:1px solid rgba(184,28,28,.2);color:var(--red);padding:12px 16px;border-radius:var(--r-sm);font-size:.84rem;margin-bottom:14px">
    Something went wrong. Please try again, or email us directly.
  </div>
  <form id="main-contact-form" action={SITE.formspreeAction} method="POST">
    <input type="hidden" name="_subject" value="Website Consultation Request — ISO Audit Align" />
    <div class="field-row">
      <div class="field-group"><label>First Name <span class="req">*</span></label><input type="text" name="First Name" placeholder="Jane" required /></div>
      <div class="field-group"><label>Last Name <span class="req">*</span></label><input type="text" name="Last Name" placeholder="Smith" required /></div>
    </div>
    <div class="field-row">
      <div class="field-group"><label>Email <span class="req">*</span></label><input type="email" name="email" placeholder="jane@company.com.au" required /></div>
      <div class="field-group"><label>Phone <span class="req">*</span></label><input type="tel" name="Phone" placeholder="+61 4XX XXX XXX" required /></div>
    </div>
    <div class="field-group"><label>Company Name <span class="req">*</span></label><input type="text" name="Company" placeholder="Acme Pty Ltd" required /></div>
    <div class="field-row">
      <div class="field-group">
        <label>Service of Interest</label>
        <select name="Service">
          <option value="">Select...</option>
          <option>ISO 27001 — Information Security</option>
          <option>ISO 9001 — Quality Management</option>
          <option>ISO 14001 — Environmental</option>
          <option>ISO 45001 — Work Health &amp; Safety</option>
          <option>ISO 42001 — AI Management</option>
          <option>NDIS Audit Support</option>
          <option>Internal Audit Support</option>
          <option>External Audit Support</option>
          <option>Cyber Security Training</option>
          <option>ISO Standards Training</option>
          <option>Audit Management &amp; Compliance</option>
          <option>Multiple / Integrated IMS</option>
          <option>Not sure yet</option>
        </select>
      </div>
      <div class="field-group">
        <label>Number of Employees</label>
        <select name="Company Size">
          <option value="">Select...</option>
          <option>1–10</option>
          <option>11–50</option>
          <option>51–200</option>
          <option>201–500</option>
          <option>500+</option>
        </select>
      </div>
    </div>
    <div class="field-group"><label>Message</label><textarea name="message" rows="4" placeholder="Tell us about your situation — timeline, requirements, or questions."></textarea></div>
    <button type="submit" class="btn" id="cf-submit" style="width:100%;padding:14px">Request Free Consultation</button>
  </form>
</div>

<script>
  const form = document.getElementById('main-contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('cf-success');
  const errorEl = document.getElementById('cf-error');
  const submitBtn = document.getElementById('cf-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (successEl) successEl.style.display = 'none';
    if (errorEl) errorEl.style.display = 'none';
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        if (successEl) successEl.style.display = 'block';
      } else if (errorEl) {
        errorEl.style.display = 'block';
      }
    } catch {
      if (errorEl) errorEl.style.display = 'block';
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Request Free Consultation'; }
    }
  });
</script>
