---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://isoauditalign.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: 'https://isoauditalign.com.au/guides/' },
  ],
};
---
<BaseLayout
  title="Guides & Resources"
  description="Plain-English guides on ISO certification costs, timelines and requirements for Australian businesses."
  jsonLd={breadcrumbJsonLd}
>
  <div class="page-hero">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line" style="background:rgba(255,255,255,.5)"></div><span class="eyebrow-text" style="color:rgba(255,255,255,.7)">Resources</span></div>
      <h1>Guides &amp; Resources</h1>
      <p>Plain-English answers to the questions we hear most from businesses starting their ISO certification journey.</p>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {guides.map((guide) => (
          <a class="card" href={`/guides/${guide.id}/`}>
            <span class="card-tag">{guide.data.category}</span>
            <h3>{guide.data.title}</h3>
            <p>{guide.data.description}</p>
            <span class="btn-ghost">Read guide →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
