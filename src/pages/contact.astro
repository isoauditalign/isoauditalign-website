---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import CalEmbed from '../components/CalEmbed.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="Contact Us — Book a Free Consultation" description="Book a free 45-minute ISO certification consultation with ISO Audit Align. Call, WhatsApp, book online, or send us your details." hideCta={true}>
  <div class="page-hero">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line" style="background:rgba(255,255,255,.5)"></div><span class="eyebrow-text" style="color:rgba(255,255,255,.7)">Contact Us</span></div>
      <h1>Book your free consultation.</h1>
      <p>A 45-minute no-obligation conversation. We'll assess your current state, estimate timelines, and give you an honest path to certification — no sales pressure.</p>
      <div class="contact-hero-highlights">
        <a href={SITE.phoneHref} class="contact-hero-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span>{SITE.phone}</span>
        </a>
        <a href={`mailto:${SITE.email}`} class="contact-hero-pill">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
          <span>{SITE.email}</span>
        </a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items:start;gap:56px">
        <div>
          <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">Book a Time</span></div>
          <h2 class="sec-h">Pick a slot that works.</h2>
          <p class="sec-intro">Book directly into our calendar, or use the form to send your details and we'll reach out within one business day.</p>
          <CalEmbed />

          <div style="margin-top:40px">
            <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">Quick &amp; Easy Way to Connect</span></div>
            <div style="display:flex;flex-direction:column;gap:12px">
              <a class="card" style="display:flex;align-items:center;gap:14px;padding:16px 20px" href={SITE.whatsapp} target="_blank" rel="noopener">
                <strong style="font-size:.9rem">WhatsApp</strong><span style="font-size:.82rem;color:var(--muted)">Quick reply, usually same day</span>
              </a>
              <a class="card" style="display:flex;align-items:center;gap:14px;padding:16px 20px" href={SITE.phoneHref}>
                <strong style="font-size:.9rem">Call Direct</strong><span style="font-size:.82rem;color:var(--muted)">{SITE.phone}</span>
              </a>
              <a class="card" style="display:flex;align-items:center;gap:14px;padding:16px 20px" href={SITE.linkedin} target="_blank" rel="noopener">
                <strong style="font-size:.9rem">LinkedIn</strong><span style="font-size:.82rem;color:var(--muted)">Connect with our page</span>
              </a>
            </div>
          </div>

          <div style="margin-top:32px;display:flex;flex-direction:column;gap:14px">
            <div><strong style="font-size:.85rem;display:block">Phone</strong><a href={SITE.phoneHref} style="font-size:.85rem;color:var(--muted)">{SITE.phone}</a></div>
            <div><strong style="font-size:.85rem;display:block">Email</strong><a href={`mailto:${SITE.email}`} style="font-size:.85rem;color:var(--muted)">{SITE.email}</a></div>
            <div><strong style="font-size:.85rem;display:block">Coverage</strong><span style="font-size:.85rem;color:var(--muted)">{SITE.coverage}</span></div>
            <div><strong style="font-size:.85rem;display:block">Hours</strong><span style="font-size:.85rem;color:var(--muted)">{SITE.hours}</span></div>
          </div>
        </div>

        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
