---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---
<BaseLayout title="Privacy Policy" description="How ISO Audit Align collects, uses, and protects personal information submitted through our contact form and free assessment tools.">
  <div class="page-hero" style="padding:72px 0 48px">
    <div class="container">
      <h1 style="font-size:clamp(26px,3.4vw,38px)">Privacy Policy</h1>
      <p>Last updated: {new Date().toLocaleDateString('en-AU', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    </div>
  </div>
  <section class="section section-tight">
    <div class="container" style="max-width:760px">
      <div style="font-size:.92rem;color:var(--muted);line-height:1.85;display:flex;flex-direction:column;gap:22px">
        <div>
          <h2 style="font-size:1.05rem;color:var(--text);margin-bottom:8px">What we collect</h2>
          <p>When you submit our contact form or one of our free self-assessment tools, we collect the information you provide directly: your name, organisation, email address, and phone number. Our free assessment tools also record your answers to the assessment questions.</p>
        </div>
        <div>
          <h2 style="font-size:1.05rem;color:var(--text);margin-bottom:8px">Why we collect it</h2>
          <p>We use this information solely to respond to your enquiry, provide the assessment report you requested, and follow up about our services. We do not sell or rent your personal information to third parties.</p>
        </div>
        <div>
          <h2 style="font-size:1.05rem;color:var(--text);margin-bottom:8px">How it's processed</h2>
          <p>Form submissions are processed by Formspree, our third-party form-handling provider, and delivered to us by email. Formspree's own privacy policy governs how they handle data in transit.</p>
        </div>
        <div>
          <h2 style="font-size:1.05rem;color:var(--text);margin-bottom:8px">Cookies and tracking</h2>
          <p>This site does not use advertising or analytics cookies. If a calendar booking widget is embedded on our Contact page, that third-party provider (Cal.com) may set its own cookies when you interact with it — refer to their privacy policy for details.</p>
        </div>
        <div>
          <h2 style="font-size:1.05rem;color:var(--text);margin-bottom:8px">Your rights</h2>
          <p>You can request access to, correction of, or deletion of your personal information at any time by contacting us at <a href={`mailto:${SITE.email}`} style="color:var(--red)">{SITE.email}</a>.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
