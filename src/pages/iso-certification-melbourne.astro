---
import BaseLayout from '../layouts/BaseLayout.astro';
import { STANDARDS } from '../data/standards';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'ISO Certification Consulting',
  name: 'ISO Certification Consultants — Melbourne',
  provider: { '@type': 'ProfessionalService', name: 'ISO Audit Align' },
  areaServed: { '@type': 'City', name: 'Melbourne' },
  description: 'ISO 27001, 9001, 14001, 45001, 42001 and NDIS certification consulting for Melbourne businesses — in-person audit day support, remote delivery for everything else.',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://isoauditalign.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'ISO Certification Melbourne', item: 'https://isoauditalign.com.au/iso-certification-melbourne/' },
  ],
};

const faqs = [
  {
    q: 'Do you work with Melbourne businesses in person?',
    a: "Yes. We're Melbourne-based, and for Melbourne clients we offer in-person support for the moments it genuinely matters most — kickoff workshops, mock audits, and certification audit days. Day-to-day project work (document review, meetings, evidence gathering) runs remotely, which keeps the engagement efficient without losing the local, in-person relationship for the parts that benefit from it.",
  },
  {
    q: 'Which certification bodies do you work with in Melbourne?',
    a: "We work with JAS-ANZ accredited certification bodies operating in Australia — DNV, BSI, and SAI Global among them — and help you choose the right one for your standard, industry, and budget rather than pushing a single preferred partner.",
  },
  {
    q: 'Which standards do you cover for Melbourne businesses?',
    a: 'All six: ISO 27001 (information security — our deepest specialty), ISO 9001, ISO 14001, ISO 45001, ISO 42001, and NDIS registration audit support. See the full list below.',
  },
  {
    q: "Do you only work with Melbourne businesses, or further afield too?",
    a: "Melbourne is home, but the majority of the engagement runs remotely regardless of location — we work with clients across Australia, the UK, US, Canada, UAE and Singapore. Melbourne clients simply get the option of in-person sessions for the parts that benefit from being in the room.",
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout
  title="ISO Certification Consultants in Melbourne"
  description="Melbourne-based ISO 27001, 9001, 14001, 45001, 42001 and NDIS certification consulting — in-person support for kickoffs, mock audits and audit days, remote delivery for everything else."
  jsonLd={[serviceJsonLd, breadcrumbJsonLd, faqJsonLd]}
>
  <div class="page-hero">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line" style="background:rgba(255,255,255,.5)"></div><span class="eyebrow-text" style="color:rgba(255,255,255,.7)">Melbourne</span></div>
      <h1>ISO Certification Consultants in Melbourne</h1>
      <p>End-to-end ISO certification support for Melbourne businesses — built locally, delivered with the same fixed-cost, hands-on model whether you're in the room with us or on a call.</p>
      <div style="display:flex;gap:16px;margin-top:28px;flex-wrap:wrap">
        <a class="btn-white" href="/contact/">Book Free Consultation →</a>
        <a class="btn-ghost" style="color:#fff" href="/assessments/">Try a Free Assessment →</a>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items:start;gap:56px">
        <div>
          <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">Local, Not Generic</span></div>
          <h2 class="sec-h">Melbourne-based. Built for how you actually work.</h2>
          <p style="color:var(--muted);font-size:.96rem;line-height:1.8;margin-bottom:20px">
            We're based in Melbourne, and for Melbourne clients that means a genuine option to meet in person — not just a phone number with an Australian area code. Kickoff workshops, mock audits, and certification audit days are where being in the room actually helps; everything else (document review, evidence gathering, regular check-ins) runs efficiently online, the same way it would for any client anywhere.
          </p>
          <p style="color:var(--muted);font-size:.96rem;line-height:1.8">
            That combination — local when it matters, remote when it's faster — is how we keep engagements fixed-price and on schedule without asking you to host us for weeks at a time.
          </p>
        </div>
        <div class="card">
          <h3>What Melbourne clients get</h3>
          <div style="display:flex;flex-direction:column;gap:14px;margin-top:18px">
            {[
              'In-person kickoff workshop to scope your management system properly',
              'On-site mock audit before the real one, so audit day isn\'t the first time it\'s been tested',
              'In-person support on Stage 1 and Stage 2 audit days with your certification body',
              'Remote delivery for everything in between — efficient, not distant',
            ].map((item) => (
              <div style="display:flex;gap:12px;align-items:start">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><path d="M20 6L9 17l-5-5"/></svg>
                <span style="font-size:.9rem;color:var(--muted);line-height:1.6">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tight" style="background:var(--panel)">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">Standards We Cover</span></div>
      <h2 class="sec-h">Six standards, one Melbourne-based consultant.</h2>
      <p class="sec-intro">ISO 27001 is our deepest specialty — the rest are covered with the same practical, no-generic-templates approach.</p>
      <div class="grid grid-3">
        {STANDARDS.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <span class="card-tag">{s.tag}</span>
            <h3>{s.h1 ?? s.name}</h3>
            <p>{s.shortDesc}</p>
            <span class="btn-ghost">View service →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">FAQ</span></div>
      <h2 class="sec-h">Common questions.</h2>
      <div style="display:flex;flex-direction:column;gap:22px;max-width:760px;margin-top:24px">
        {faqs.map((f) => (
          <div class="card" style="padding:24px 28px">
            <h3 style="margin-bottom:8px">{f.q}</h3>
            <p style="color:var(--muted);font-size:.92rem;line-height:1.7;margin:0">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
