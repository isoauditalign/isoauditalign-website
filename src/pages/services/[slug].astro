---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STANDARDS } from '../../data/standards';
import { AUDIT_SERVICES } from '../../data/auditServices';

export function getStaticPaths() {
  return [...STANDARDS, ...AUDIT_SERVICES].map((s) => ({ params: { slug: s.slug }, props: { standard: s } }));
}

const { standard } = Astro.props;

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: standard.name,
  name: `${standard.tag} — ${standard.name}`,
  provider: { '@type': 'ProfessionalService', name: 'ISO Audit Align' },
  areaServed: { '@type': 'Country', name: 'Australia' },
  description: standard.shortDesc,
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://isoauditalign.com.au/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://isoauditalign.com.au/#services' },
    { '@type': 'ListItem', position: 3, name: standard.name, item: `https://isoauditalign.com.au/services/${standard.slug}/` },
  ],
};
---
<BaseLayout
  title={`${standard.tag} — ${standard.name}`}
  description={standard.shortDesc}
  jsonLd={[serviceJsonLd, breadcrumbJsonLd]}
>
  <div class="page-hero">
    <div class="container">
      <div class="eyebrow-wrap"><div class="eyebrow-line" style="background:rgba(255,255,255,.5)"></div><span class="eyebrow-text" style="color:rgba(255,255,255,.7)">{standard.tag}</span></div>
      <h1>{standard.name}</h1>
      <p>{standard.heroCopy}</p>
      <div style="display:flex;gap:16px;margin-top:28px;flex-wrap:wrap">
        <a class="btn-white" href="/contact/">Book Free Consultation →</a>
        {standard.assessmentSlug && (
          <a class="btn-ghost" style="color:#fff" href={`/assessments/${standard.assessmentSlug}/`}>Try Free Assessment →</a>
        )}
      </div>
    </div>
  </div>

  <section class="section section-tight" style="background:var(--panel)">
    <div class="container">
      <div class="eyebrow-wrap reveal"><div class="eyebrow-line"></div><span class="eyebrow-text">How It Works</span></div>
      <h2 class="sec-h reveal">Our {standard.name} workflow.</h2>
      <p class="sec-intro reveal">A clear, staged process — so you always know what's happening next and why.</p>
      <div class="workflow reveal-stagger" style={`--wf-cols:${standard.workflow.length}`}>
        <svg class="workflow-connector" viewBox="0 0 100 4" preserveAspectRatio="none" aria-hidden="true"><line x1="0" y1="2" x2="100" y2="2" stroke="var(--border)" stroke-width="1.5" stroke-dasharray="3 3"/></svg>
        {standard.workflow.map((step, i) => (
          <div class="workflow-step">
            <div class="workflow-step-node">{i + 1}</div>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items:start;gap:56px">
        <div>
          <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">What's Included</span></div>
          <h2 class="sec-h">Full scope, start to finish.</h2>
          <div style="display:flex;flex-direction:column;gap:14px;margin-top:24px">
            {standard.whatIncluded.map((item) => (
              <div style="display:flex;gap:12px;align-items:start">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--red)" stroke-width="2.5" style="flex-shrink:0;margin-top:2px"><path d="M20 6L9 17l-5-5"/></svg>
                <span style="font-size:.92rem;color:var(--muted);line-height:1.6">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="card" style="position:sticky;top:116px">
          <h3>Not sure where you stand?</h3>
          <p>Run our free {standard.tag} self-assessment for an instant readiness score and tailored improvement priorities — no sign-up required.</p>
          {standard.assessmentSlug ? (
            <a class="btn" href={`/assessments/${standard.assessmentSlug}/`} style="width:100%;text-align:center">Start Free Assessment →</a>
          ) : (
            <a class="btn" href="/contact/" style="width:100%;text-align:center">Book Free Consultation →</a>
          )}
        </div>
      </div>
    </div>
  </section>

  {standard.relatedGuides && standard.relatedGuides.length > 0 && (
    <section class="section-tight" style="background:var(--panel)">
      <div class="container">
        <div class="eyebrow-wrap"><div class="eyebrow-line"></div><span class="eyebrow-text">Further Reading</span></div>
        <h2 class="sec-h">Related guides.</h2>
        <div class="grid grid-3">
          {standard.relatedGuides.map((g) => (
            <a class="card" href={g.type === 'case-study' ? `/case-studies/${g.slug}/` : `/guides/${g.slug}/`}>
              <span class="card-tag">{g.type === 'case-study' ? 'Case Study' : 'Guide'}</span>
              <h3>{g.title}</h3>
              <span class="btn-ghost">{g.type === 'case-study' ? 'Read case study →' : 'Read guide →'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
