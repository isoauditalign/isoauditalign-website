---
import BaseLayout from './BaseLayout.astro';
import '../styles/assessment.css';

interface Props {
  title: string;
  description: string;
  barTitle: string;
  barSub: string;
}

const { title, description, barTitle, barSub } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <div class="assess-bar">
    <div style="display:flex;align-items:center;gap:12px">
      <a class="assess-back" href="/assessments/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Assessments
      </a>
      <div>
        <div class="assess-bar-title">{barTitle}</div>
        <div class="assess-bar-sub">{barSub}</div>
      </div>
    </div>
    <span class="mono" style="color:var(--muted)">Powered by ISO Audit Align</span>
  </div>
  <slot />
</BaseLayout>
